# Runtime mode: fixture is deterministic for local demos; postgres is deployment mode.
APP_ENV=demo
APP_MODE=fixture
DEMO_PRINCIPAL=allowed-user
API_HOST=0.0.0.0
API_PORT=8102

# Supabase/PostgreSQL. Keep private service-role/direct credentials server-side only.
DATABASE_URL=
SUPABASE_POOLER_URL=
SUPABASE_DIRECT_URL=
DB_SSL_MODE=require

# Retrieval and background services.
SEARCH_PROVIDER=fixture
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=knowledge-items-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
QUEUE_PROVIDER=inline
REDIS_URL=redis://localhost:6379/0

# Server-side model adapter. Fixture mode does not call a model provider.
MODEL_PROVIDER=fixture
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_NAME=

# Operational controls.
APP_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_TOKEN=
CONNECTOR_CREDENTIALS_ENCRYPTION_KEY=
ADMIN_PRINCIPAL_KEYS=admin-user
AUDIT_RETENTION_DAYS=
# The browser uses the same-origin proxy. API_ORIGIN is server-only for the web container.
API_ORIGIN=http://api:8102
